      '<div class="log-list">'+
      (entries.length?entries.map(function(e){ return '<div class="log-item"><div class="date">'+esc(fmtDate(e.date))+'</div><div class="note">'+esc(e.note)+'</div></div>'; }).join(""):'<div class="empty-state">No entries yet.</div>')+
      '</div></div>';
    document.getElementById("app").innerHTML=html;
  }

  function render(){
    renderTabs(); renderTopbar();
    if(activeTab==="overview") renderOverview();
    else if(activeTab==="ledger") renderLedger();
    else if(activeTab==="positions") renderPositions();
    else if(activeTab==="trades") renderTrades();
    else if(activeTab==="scorecard") renderScorecard();
    else if(activeTab==="scaling") renderScaling();
    else if(activeTab==="calculator") renderCalculator();
    else if(activeTab==="audit") renderAudit();
  }

  render();
})();
</script>

</body>
</html>
