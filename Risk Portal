<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Blossombanx.riskportal</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
  :root{ color-scheme: light; }
  *{ box-sizing:border-box; }
  body{ margin:0; }
  img{ max-width:100%; }
  [hidden]{ display:none !important; }
  :root{
    --bg:#eef1ee; --surface:#ffffff; --surface-2:#f5f7f4;
    --ink:#16231f; --muted:#5c6b64; --line:#dbe1db;
    --accent:#8a6d3b; --accent-ink:#4a3a1f; --accent-soft:#f1e8d8;
    --good:#2f7d5c; --good-bg:#e3f1e9;
    --bad:#b3463c; --bad-bg:#fbe9e7;
    --warn:#c08a2e; --warn-bg:#f8eed9;
    --pending:#8a938e; --pending-bg:#eceeec;
    --gold:#a9822e; --gold-bg:#f7ecd3;
    --shadow: 0 1px 2px rgba(22,35,31,.06), 0 1px 1px rgba(22,35,31,.04);
    --font-display: "IBM Plex Serif", Georgia, "Times New Roman", serif;
    --font-body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-mono: "IBM Plex Mono", "SFMono-Regular", Consolas, monospace;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#0f1715; --surface:#17211e; --surface-2:#1d2723;
      --ink:#e9ece9; --muted:#93a39c; --line:#2a3733;
      --accent:#d1a054; --accent-ink:#2a2013; --accent-soft:#2a2417;
      --good:#4fae82; --good-bg:#163527;
      --bad:#e07268; --bad-bg:#3a1c18;
      --warn:#d9a94a; --warn-bg:#3a2e14;
      --pending:#7c8b85; --pending-bg:#1c2521;
      --gold:#e0b95c; --gold-bg:#332a13;
      --shadow: 0 1px 2px rgba(0,0,0,.35), 0 1px 1px rgba(0,0,0,.25);
    }
  }
  :root[data-theme="dark"]{
    --bg:#0f1715; --surface:#17211e; --surface-2:#1d2723;
    --ink:#e9ece9; --muted:#93a39c; --line:#2a3733;
    --accent:#d1a054; --accent-ink:#2a2013; --accent-soft:#2a2417;
    --good:#4fae82; --good-bg:#163527;
    --bad:#e07268; --bad-bg:#3a1c18;
    --warn:#d9a94a; --warn-bg:#3a2e14;
    --pending:#7c8b85; --pending-bg:#1c2521;
    --gold:#e0b95c; --gold-bg:#332a13;
    --shadow: 0 1px 2px rgba(0,0,0,.35), 0 1px 1px rgba(0,0,0,.25);
  }

  body{ background:var(--bg); color:var(--ink); font-family:var(--font-body); }
  #app, .topbar, .tabs{ max-width:980px; margin:0 auto; padding-inline:16px; box-sizing:border-box; }
  h1,h2,h3{ font-family:var(--font-display); text-wrap:balance; margin:0; }
  table{ font-variant-numeric:tabular-nums; }
  .num{ font-family:var(--font-mono); font-variant-numeric:tabular-nums; }
  button, input, select, textarea{ font-family:inherit; font-size:14px; color:var(--ink); }
  a{ color:var(--accent); }

  .topbar{ display:flex; align-items:center; justify-content:space-between; gap:12px; padding-block:14px 10px; flex-wrap:wrap; }
  .brand{ display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; }
  .brand h1{ font-size:22px; font-weight:600; letter-spacing:.2px; }
  .brand .sub{ color:var(--muted); font-size:12.5px; text-transform:uppercase; letter-spacing:.08em; }
  .topbar-right{ display:flex; align-items:center; gap:14px; }
  .balance-tile{ text-align:right; }
  .balance-tile .lbl{ font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.08em; }
  .balance-tile .val{ font-family:var(--font-mono); font-size:20px; font-weight:600; }
  .updated-pill{
    font-size:11px; font-weight:600; letter-spacing:.03em;
    padding:4px 9px; border-radius:99px; border:1px solid var(--line); color:var(--muted);
    white-space:nowrap;
  }

  .tabs{ display:flex; gap:4px; border-bottom:1px solid var(--line); overflow-x:auto; scrollbar-width:thin; }
  .tab-btn{
    background:none; border:none; padding:10px 12px; margin-bottom:-1px; cursor:pointer;
    color:var(--muted); font-weight:500; font-size:13.5px; border-bottom:2px solid transparent; white-space:nowrap;
  }
  .tab-btn.active{ color:var(--ink); border-bottom-color:var(--accent); }
  .tab-btn:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible{
    outline:2px solid var(--accent); outline-offset:2px;
  }

  main{ padding-block:20px 48px; display:flex; flex-direction:column; gap:22px; }

  .card{ background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:16px 18px; box-shadow:var(--shadow); }
  .card h2{ font-size:15px; font-weight:600; }
  .card-head{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:12px; flex-wrap:wrap; }
  .muted{ color:var(--muted); }
  .hint{ font-size:12.5px; color:var(--muted); }

  .stat-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:10px; }
  .stat-tile{ background:var(--surface-2); border:1px solid var(--line); border-radius:8px; padding:12px 14px; display:flex; flex-direction:column; gap:4px; }
  .stat-tile .lbl{ font-size:11.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; }
  .stat-tile .val{ font-family:var(--font-mono); font-size:19px; font-weight:600; }
  .stat-tile .sub{ font-size:12px; color:var(--muted); }
  .up{ color:var(--good); } .down{ color:var(--bad); }

  .nonneg{ display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:10px; }
  .nonneg .item{ background:var(--surface-2); border:1px solid var(--line); border-radius:8px; padding:12px 14px; }
  .nonneg .item .n{ font-family:var(--font-mono); color:var(--accent); font-weight:600; font-size:12px; }
  .nonneg .item .t{ font-weight:600; margin-top:2px; }
  .nonneg .item .d{ font-size:12.5px; color:var(--muted); margin-top:2px; }

  .pill{ display:inline-flex; align-items:center; gap:4px; font-size:12px; font-weight:600; padding:3px 8px; border-radius:99px; }
  .pill.good{ background:var(--good-bg); color:var(--good); }
  .pill.bad{ background:var(--bad-bg); color:var(--bad); }
  .pill.pending{ background:var(--pending-bg); color:var(--pending); }
  .pill.warn{ background:var(--warn-bg); color:var(--warn); }
  .pill.gold{ background:var(--gold-bg); color:var(--gold); }

  .table-wrap{ overflow-x:auto; border:1px solid var(--line); border-radius:8px; }
  table{ width:100%; border-collapse:collapse; min-width:520px; }
  th,td{ text-align:left; padding:9px 12px; border-bottom:1px solid var(--line); font-size:13.5px; white-space:nowrap; }
  th{ font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); font-weight:600; background:var(--surface-2); }
  tr:last-child td{ border-bottom:none; }
  td.wrap{ white-space:normal; min-width:140px; }

  .day-grid{ display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:8px; }
  .day-cell{ background:var(--surface-2); border:1px solid var(--line); border-radius:8px; padding:10px; display:flex; flex-direction:column; gap:6px; }
  .day-cell .day-name{ font-size:11.5px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); font-weight:600; }

  .field{ display:flex; flex-direction:column; gap:4px; }
  .field label{ font-size:11.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; }
  .field input, .field select{ padding:7px 9px; border:1px solid var(--line); border-radius:6px; background:var(--surface); min-width:0; }
  .form-row{ display:flex; flex-wrap:wrap; gap:10px; align-items:end; }
  .field.grow{ flex:1; min-width:150px; }

  .btn{ background:var(--accent); color:#fff; border:none; border-radius:7px; padding:8px 14px; font-weight:600; font-size:13px; cursor:pointer; white-space:nowrap; }
  .btn:hover{ filter:brightness(1.05); }
  .btn.secondary{ background:transparent; color:var(--ink); border:1px solid var(--line); }
  .btn.small{ padding:5px 10px; font-size:12px; }

  .empty-state{ text-align:center; padding:28px 12px; color:var(--muted); font-size:13.5px; }

  .toast{ position:fixed; left:50%; bottom:22px; transform:translateX(-50%); background:var(--ink); color:var(--bg); padding:9px 16px; border-radius:8px; font-size:13px; box-shadow:var(--shadow); z-index:50; }

  svg.chart text{ fill:var(--muted); font-family:var(--font-mono); font-size:10px; }
  svg.chart .grid{ stroke:var(--line); stroke-width:1; }
  svg.chart .target-line{ stroke:var(--accent); stroke-width:2; fill:none; stroke-dasharray:5 4; }
  svg.chart .actual-line{ stroke:var(--good); stroke-width:2.5; fill:none; }
  svg.chart .actual-dot{ fill:var(--good); }
  svg.chart .target-dot{ fill:var(--accent); }

  .score-wrap{ display:flex; align-items:center; gap:20px; flex-wrap:wrap; }
  .score-ring{ position:relative; width:112px; height:112px; flex:none; }
  .score-ring svg{ width:100%; height:100%; transform:rotate(-90deg); }
  .score-ring .track{ stroke:var(--line); fill:none; stroke-width:10; }
  .score-ring .fill{ stroke:var(--accent); fill:none; stroke-width:10; stroke-linecap:round; transition:stroke-dashoffset .4s; }
  .score-ring .num{ position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; font-family:var(--font-mono); }
  .score-ring .num b{ font-size:26px; line-height:1; }
  .score-ring .num span{ font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; }
  .tier-badge{ display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border-radius:99px; font-weight:600; font-size:13px; }
  .badge-row{ display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }

  .calc-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; }
  .calc-result{ background:var(--accent-soft); border-radius:8px; padding:14px 16px; margin-top:14px; }
  .calc-result .big{ font-family:var(--font-mono); font-size:24px; font-weight:600; color:var(--accent-ink); }

  .log-list{ display:flex; flex-direction:column; gap:0; }
  .log-item{ display:flex; gap:14px; padding:12px 0; border-bottom:1px solid var(--line); }
  .log-item:last-child{ border-bottom:none; }
  .log-item .date{ font-family:var(--font-mono); font-size:12px; color:var(--muted); white-space:nowrap; padding-top:1px; }
  .log-item .note{ font-size:13.5px; }

  textarea.report-box{ width:100%; min-height:260px; font-family:var(--font-mono); font-size:12.5px; padding:12px; border:1px solid var(--line); border-radius:8px; background:var(--surface-2); resize:vertical; }

  @media (max-width:520px){
    .day-grid{ grid-template-columns:1fr 1fr; }
    .balance-tile{ text-align:left; }
    .topbar{ flex-direction:column; align-items:flex-start; }
  }
</style>
</head>
