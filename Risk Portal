<script id="app-script">
(function(){
  "use strict";

  var state = JSON.parse(document.getElementById("state-data").textContent);
  var activeTab = "overview";
  var tradeFilter = "all";

  var TABS = [
    { id: "overview", label: "Overview" },
    { id: "ledger", label: "Weekly Ledger" },
    { id: "positions", label: "Positions" },
    { id: "trades", label: "Trade Log" },
    { id: "scorecard", label: "Scorecard" },
    { id: "scaling", label: "Scaling Plan" },
    { id: "calculator", label: "Calculator" },
    { id: "audit", label: "Audit Trail" }
  ];

  var MONEY = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP" });
  var MONEY_COMPACT = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP", notation: "compact", maximumFractionDigits: 1 });

  function fmtMoney(n){ if(n===null||n===undefined||isNaN(n)) return "–"; return MONEY.format(n); }
  function fmtMoneyCompact(n){ if(n===null||n===undefined||isNaN(n)) return "–"; return MONEY_COMPACT.format(n); }
  function fmtPct(n, digits){ if(n===null||n===undefined||isNaN(n)) return "–"; return (n>=0?"+":"") + n.toFixed(digits===undefined?2:digits) + "%"; }
  function esc(s){ return String(s===undefined||s===null?"":s).replace(/[&<>"']/g, function(c){ return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]; }); }
  function sum(arr){ return arr.reduce(function(a,b){ return a+b; },0); }
  function avg(arr){ return arr.length? sum(arr)/arr.length : null; }
  function fmtDate(iso){ var d=parseISODate(iso); return d.getUTCDate()+" "+MONTH_NAMES[d.getUTCMonth()]+" "+d.getUTCFullYear(); }

  function parseISODate(s){ var p=s.split("-").map(Number); return new Date(Date.UTC(p[0],p[1]-1,p[2])); }
  function toISODate(d){ return d.toISOString().slice(0,10); }
  function addDays(iso, n){ var d=parseISODate(iso); d.setUTCDate(d.getUTCDate()+n); return toISODate(d); }
  var MONTH_NAMES = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  function weekLabel(weekStartISO){
    var start = parseISODate(weekStartISO), end = parseISODate(addDays(weekStartISO,4));
    var sameMonth = start.getUTCMonth()===end.getUTCMonth();
    var startPart = start.getUTCDate() + (sameMonth?"":" "+MONTH_NAMES[start.getUTCMonth()]);
    var endPart = end.getUTCDate()+" "+MONTH_NAMES[end.getUTCMonth()]+" "+end.getUTCFullYear();
    return startPart+"–"+endPart;
  }
  function monthLabel(ym){ var p=ym.split("-"); return MONTH_NAMES[Number(p[1])-1]+" "+p[0]; }
  function addMonths(ym, n){ var p=ym.split("-").map(Number); var total=p[0]*12+(p[1]-1)+n; var y=Math.floor(total/12); var m=(total%12+12)%12; return y+"-"+String(m+1).padStart(2,"0"); }
  function monthsBetween(a,b){ var pa=a.split("-").map(Number), pb=b.split("-").map(Number); return (pb[0]-pa[0])*12+(pb[1]-pa[1]); }
  function quarterLabel(ym){ var p=ym.split("-"); var q=Math.floor((Number(p[1])-1)/3)+1; return "Q"+q+" "+p[0]; }

  // ---- derived calculations ----
  function weekPL(w){ return w.days.reduce(function(s,d){ return s+(typeof d.pl==="number"?d.pl:0); },0); }
  function weekClosing(w){ return w.openingBalance + weekPL(w); }
  function weekDailyMax(w){ return w.openingBalance * state.settings.dailyMaxPct/100; }
  function weekWeeklyMax(w){ return w.openingBalance * state.settings.weeklyMaxPct/100; }
  function weekCompliance(w){
    var good=0,bad=0,pend=0;
    w.days.forEach(function(d){ if(d.status==="compliant") good++; else if(d.status==="breach") bad++; else pend++; });
    return { good:good, bad:bad, pending:pend };
  }
  function weekFullyCompliant(w){ var c=weekCompliance(w); return c.bad===0 && c.pending===0; }
  function sortedWeeks(){ return state.weeks.slice().sort(function(a,b){ return a.weekStart<b.weekStart?-1:1; }); }
  function currentBalance(){ var ws=sortedWeeks(); return ws.length? weekClosing(ws[ws.length-1]) : state.meta.programStartBalance; }
  function totalReturnPct(){ var start=state.meta.programStartBalance; return (currentBalance()-start)/start*100; }
  function equitySeries(){
    var pts=[{ label: state.meta.programStartLabel, value: state.meta.programStartBalance }];
    sortedWeeks().forEach(function(w){ pts.push({ label: weekLabel(w.weekStart), value: weekClosing(w) }); });
    return pts;
  }
  function streaks(){
    var ws=sortedWeeks(), longest=0, run=0, current=0;
    ws.forEach(function(w){ if(weekFullyCompliant(w)){ run++; longest=Math.max(longest,run); } else run=0; });
    for(var i=ws.length-1;i>=0;i--){ if(weekFullyCompliant(ws[i])) current++; else break; }
    return { current:current, longest:longest };
  }
  function allTimeCompliancePct(){
    var good=0, evaluated=0;
    sortedWeeks().forEach(function(w){ w.days.forEach(function(d){ if(d.status!=="pending"){ evaluated++; if(d.status==="compliant") good++; } }); });
    return evaluated? good/evaluated*100 : null;
  }
  function disciplineScore(){
    var c=allTimeCompliancePct(); if(c===null) return null;
    var st=streaks();
    return Math.max(0, Math.min(100, Math.round(c*0.8 + Math.min(st.current,10)*2)));
  }
  function prestigeTier(streakWeeks){
    if(streakWeeks>=12) return "Platinum";
    if(streakWeeks>=8) return "Gold";
    if(streakWeeks>=4) return "Silver";
    if(streakWeeks>=2) return "Bronze";
    return "Unranked";
  }
  function longestDayStreak(){
    var longest=0, run=0;
    sortedWeeks().forEach(function(w){
      w.days.forEach(function(d){ if(d.status==="compliant"){ run++; longest=Math.max(longest,run); } else if(d.status==="breach"){ run=0; } });
    });
    return longest;
  }
  function weekBadge(w){
    var c=weekCompliance(w);
    if(c.bad>0) return {text:"Breach", cls:"bad"};
    if(c.pending>0) return {text:"In progress", cls:"pending"};
    var ret = weekPL(w)/w.openingBalance*100;
    var paceTarget = (Math.pow(1+state.scalingPlan.monthlyRatePct/100, 1/4.345)-1)*100;
    if(ret>=paceTarget) return {text:"Elite week", cls:"gold"};
    if(ret>=0) return {text:"On plan", cls:"good"};
    return {text:"Recovery week", cls:"warn"};
  }
  function tradeStats(trades){
    var wins=trades.filter(function(t){return t.result>0;});
    var losses=trades.filter(function(t){return t.result<0;});
    var grossWin=sum(wins.map(function(t){return t.result;}));
    var grossLoss=Math.abs(sum(losses.map(function(t){return t.result;})));
    var rrs=trades.filter(function(t){return typeof t.rr==="number";}).map(function(t){return t.rr;});
    var best=trades.length? trades.reduce(function(a,b){return b.result>a.result?b:a;}) : null;
    var worst=trades.length? trades.reduce(function(a,b){return b.result<a.result?b:a;}) : null;
    return {
      count: trades.length,
      winRate: trades.length? wins.length/trades.length*100 : null,
      avgWin: avg(wins.map(function(t){return t.result;})),
      avgLoss: avg(losses.map(function(t){return t.result;})),
      profitFactor: grossLoss>0? grossWin/grossLoss : (grossWin>0? null : null),
      expectancy: avg(trades.map(function(t){return t.result;})),
      avgRR: avg(rrs),
      best: best, worst: worst
    };
  }
  function filteredTrades(){
    var trades = state.trades.slice().sort(function(a,b){ return a.date<b.date?1:-1; });
    if(tradeFilter==="all") return trades;
    var today = new Date(); var cutoff;
    if(tradeFilter==="30d"){ cutoff = new Date(today); cutoff.setUTCDate(cutoff.getUTCDate()-30); }
    else { cutoff = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), 1)); }
    var cutoffISO = cutoff.toISOString().slice(0,10);
    return trades.filter(function(t){ return t.date>=cutoffISO; });
  }

  function toast(msg){
    var el=document.querySelector(".toast"); if(el) el.remove();
    el=document.createElement("div"); el.className="toast"; el.textContent=msg;
    document.body.appendChild(el); setTimeout(function(){ el.remove(); }, 2600);
  }

  // ---- chart ----
  function chartSVG(series, opts){
    opts=opts||{};
    var w=880,h=220,padL=64,padR=16,padT=16,padB=28;
    var vals=series.map(function(p){return p.value;});
    if(opts.extra) vals=vals.concat(opts.extra.map(function(p){return p.value;}));
    var max=Math.max.apply(null,vals)*1.08, min=Math.min(0,Math.min.apply(null,vals));
    function x(i,n){ return padL+(n<=1?0:(w-padL-padR)*i/(n-1)); }
    function y(v){ return padT+(h-padT-padB)*(1-(v-min)/(max-min||1)); }
    var gridVals=[0,0.25,0.5,0.75,1].map(function(f){ return min+(max-min)*f; });
    var grid=gridVals.map(function(gv){
      return '<line class="grid" x1="'+padL+'" x2="'+(w-padR)+'" y1="'+y(gv)+'" y2="'+y(gv)+'"/>'+'<text x="4" y="'+(y(gv)+3)+'">'+esc(fmtMoneyCompact(gv))+"</text>";
    }).join("");
    var mainPath=series.map(function(p,i){ return (i===0?"M":"L")+x(i,series.length).toFixed(1)+","+y(p.value).toFixed(1); }).join(" ");
    var dots=series.map(function(p,i){ return '<circle class="actual-dot" cx="'+x(i,series.length).toFixed(1)+'" cy="'+y(p.value).toFixed(1)+'" r="3.5"/>'; }).join("");
    var labels=series.map(function(p,i){
      if(series.length>1 && i!==0 && i!==series.length-1 && series.length>6 && i%Math.ceil(series.length/6)!==0) return "";
      return '<text x="'+x(i,series.length).toFixed(1)+'" y="'+(h-8)+'" text-anchor="middle">'+esc(p.label)+"</text>";
    }).join("");
    var extraPath="", extraDots="";
    if(opts.extra && opts.extra.length){
      extraPath='<path class="target-line" d="'+opts.extra.map(function(p,i){ return (i===0?"M":"L")+x(i,opts.extra.length).toFixed(1)+","+y(p.value).toFixed(1); }).join(" ")+'"/>';
      extraDots=[0,opts.extra.length-1].map(function(i){ return '<circle class="target-dot" cx="'+x(i,opts.extra.length).toFixed(1)+'" cy="'+y(opts.extra[i].value).toFixed(1)+'" r="3"/>'; }).join("");
    }
    return '<svg class="chart" viewBox="0 0 '+w+' '+h+'" style="width:100%;height:auto;display:block">'+grid+extraPath+extraDots+'<path class="actual-line" d="'+mainPath+'"/>'+dots+labels+"</svg>";
  }

  // ---- rollups ----
  function monthlyRollup(){
    var map={};
    sortedWeeks().forEach(function(w){
      var ym=w.weekStart.slice(0,7);
      if(!map[ym]) map[ym]={ ym:ym, weeks:0, pl:0, openStart:null, good:0, evaluated:0 };
      var m=map[ym]; m.weeks++; m.pl+=weekPL(w);
      if(m.openStart===null) m.openStart=w.openingBalance;
      w.days.forEach(function(d){ if(d.status!=="pending"){ m.evaluated++; if(d.status==="compliant") m.good++; } });
    });
    return Object.keys(map).sort().map(function(k){ return map[k]; });
  }
  function quarterlyRollup(){
    var months=monthlyRollup(), map={};
    months.forEach(function(m){
      var qk=m.ym.slice(0,4)+"-"+quarterLabel(m.ym).slice(0,2);
      if(!map[qk]) map[qk]={ label: quarterLabel(m.ym), pl:0, openStart:null, good:0, evaluated:0 };
      var q=map[qk]; q.pl+=m.pl; if(q.openStart===null) q.openStart=m.openStart; q.good+=m.good; q.evaluated+=m.evaluated;
    });
    return Object.keys(map).sort().map(function(k){ return map[k]; });
  }

  // ---- scaling plan ----
  function scalingTable(){
    var sp=state.scalingPlan, n=monthsBetween(sp.startMonth, sp.endMonth), rows=[];
    for(var i=0;i<=n;i++){
      var ym=addMonths(sp.startMonth,i);
      var target=sp.startBalance*Math.pow(1+sp.monthlyRatePct/100,i);
      var weekInMonth=sortedWeeks().filter(function(w){ return w.weekStart.slice(0,7)===ym; }).pop();
      rows.push({ ym:ym, target:target, actual: weekInMonth? weekClosing(weekInMonth) : null });
    }
    return rows;
  }

